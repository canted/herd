NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_BASE_URL=http://localhost:8787
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional local HTTPS for real phone testing. Generate with `pnpm dev:cert`.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Local development can use in-memory stores. Set these for Postgres-backed storage.
DATABASE_URL=
DIRECT_DATABASE_URL=
DATABASE_POOL_SIZE=5

# Resend is optional locally. When absent, magic links are logged to the server console
# and returned in the API response as devVerifyUrl.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Herd <auth@example.com>"

# Tigris / S3-compatible private package storage.
TIGRIS_ENDPOINT=
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_REGION=auto

# Explicit development escape hatch for older local scripts that still pass ownerEmail.
ALLOW_DEV_OWNER_EMAIL=false

HERD_VERSION=local
HERD_BUILD_TIME=
GIT_COMMIT_SHA=
