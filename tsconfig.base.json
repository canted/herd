{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@herd/composition": ["./packages/composition/src/index.ts"],
      "@herd/protocol": ["./packages/protocol/src/index.ts"],
      "@herd/runtime": ["./packages/runtime/src/index.ts"]
    }
  }
}
